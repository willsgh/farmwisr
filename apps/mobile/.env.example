# Copy to .env.local and fill in from your Supabase project (Settings > API).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: satellite tiles for field mapping (an XYZ raster URL with {z}/{x}/{y}) and their attribution.
# Defaults to Esri World Imagery, which is fine for development; pick a provider and plan before pilots.
EXPO_PUBLIC_MAP_TILES_URL=
EXPO_PUBLIC_MAP_ATTRIBUTION=
