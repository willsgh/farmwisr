{
  "expo": {
    "name": "FarmWisr",
    "slug": "farmwisr",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.farmwisr.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.farmwisr.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "scheme": "farmwisr",
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FarmWisr uses your location to map a field's boundary as you walk it."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "FarmWisr uses the camera to take photos of farm work.",
          "photosPermission": "FarmWisr lets you attach photos of farm work to activities.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
